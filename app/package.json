{
  "name": "weave",
  "version": "0.1.0",
  "description": "Decentralized private collaboration over Tor + ENSv2",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run renderer:dev\" \"tsc -w\" \"electron .\"",
    "build": "npm run renderer:build && tsc",
    "renderer:build": "vite build renderer --outDir ../renderer/out",
    "renderer:dev": "vite renderer --port 3000",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@noble/ciphers": "^0.6.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "bittorrent-dht": "^10.0.0",
    "concurrently": "^8.0.0",
    "electron": "^32.0.0",
    "helia": "^3.0.0",
    "nostr-tools": "^2.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.21"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "extensionsToTreatAsEsm": [],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "moduleResolution": "node",
          "module": "commonjs",
          "lib": [
            "ES2022"
          ],
          "target": "ES2022"
        }
      }
    }
  }
}
